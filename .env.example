# ── Control Plane ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sandbox:sandbox@postgres:5432/sandbox
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-min-32-chars-random-string-here
ENCRYPTION_KEY=base64-encoded-32-byte-aes-key-here

# ── Auth ───────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Host Agent ─────────────────────────────────────────────────────────────────
HOST_AGENT_TOKEN=change-me-shared-secret-for-dev
MTLS_CA_CERT=                       # path to CA cert for mTLS (production)
MTLS_CLIENT_CERT=                   # control plane client cert
MTLS_CLIENT_KEY=                    # control plane client key

# ── LLM Metering Gateway ───────────────────────────────────────────────────────
METERING_GATEWAY_PORT=8888
OPENAI_API_BASE=https://api.openai.com
ANTHROPIC_API_BASE=https://api.anthropic.com

# ── CORS ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Demo Mode ─────────────────────────────────────────────────────────────────
DEMO_ENABLED=true
DEMO_COST_CAP_USD=0.01

# ── Observability ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
PROMETHEUS_PORT=9090

# ── Caddy (production only) ────────────────────────────────────────────────────
DOMAIN=yourdomain.example.com
ACME_EMAIL=admin@yourdomain.example.com

# ── Postgres ───────────────────────────────────────────────────────────────────
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=sandbox
POSTGRES_DB=sandbox
